<?xml version="1.0" encoding="UTF-8"?>

<page>
	<!-- Page ID -->
	<id>p001</id>
		
	<!-- List of image assets to use on the page-->	
	<image id="bg" assetid="cutscenes/intro/one_bg"/>
	<image id="island" assetid="cutscenes/intro/one_fore"/>
	

	<!-- Script which controls what happens on the page-->
	
	<script>	
		<!-- MUST CREATE ALL ASSETS HERE -->

        <step type="create">
        	<type>bitmap</type>
			<id>bg</id>
			<image>bg</image>
			<layer>0</layer>
            <pos x="-200" y="-150"/>
		</step>
			
        <step type="create">
        	<type>bitmap</type>
			<id>island</id>
			<image>island</image>
			<layer>1</layer>
            <pos x="-260" y="-210"/>
		</step>
			
		<!-- BEGIN SCRIPT HERE -->
		
		<!-- Set origin of image for scaling / rotating etc -->		
		<step type="setorigin">
			<id>island</id> <!-- R - Image id for script -->
			<origin x=".45" y=".62"/> <!-- O - What the origin will be -->
		</step>
				
		<!-- Tween an image -->
		
		<step type="setvalue">
			<id>island</id>
			<type>s</type> <!-- R - Type - tx ty (translate) r (rot) a (alpha) sx sy (scale) -->
			<destPoint x=".7" y=".7"/> <!-- O - Point to move to if necessary -->
		</step>
      
		<step type="tween">
			<id>island</id> <!-- R - Image id for script -->
			<type>s</type> <!-- R - Type - tx ty (translate) r (rot) a (alpha) sx sy (scale) -->
			<rate>5</rate> <!-- R - Rate of tween -->
			<delay>1.5</delay>
			<destPoint x="1.05" y="1.05"/> <!-- O - Point to move to if necessary -->
			<ease>ease</ease>
		</step>
		
		<step type="tween">
			<id>island</id> <!-- R - Image id for script -->
			<type>rty</type> <!-- R - Type - tx ty (translate) r (rot) a (alpha) sx sy (scale) -->
			<rate>5</rate> <!-- R - Rate of tween -->
			<delay>1.5</delay>
			<dest>-150</dest>
			<ease>ease</ease>
		</step>
					
        <step type="wait">
            <time>.5</time>
        </step>
        
        <step type="wait">
            <input>any</input>
            <delayprogress>6.25</delayprogress>
        </step>
        
        <step type="qpage">
            <id>p002</id>
            <wipe>ls</wipe>
            <rate>d</rate>
        </step>
        
        <step type="end"/>
        
	</script>
</page>