<?xml version="1.0" encoding="UTF-8"?>

<page>
	<!-- Page ID -->
	<id>p004</id>
		
	<!-- List of image assets to use on the page-->	
	<image id="bg" assetid="cutscenes/intro/four"/>

	<!-- Script which controls what happens on the page-->
	
	<script>	
		<!-- MUST CREATE ALL ASSETS HERE -->

        <step type="create">
        	<type>bitmap</type>
			<id>bg</id>
			<image>bg</image>
			<layer>0</layer>
            <pos x="-450" y="-200"/>
		</step>
			
		<!-- BEGIN SCRIPT HERE -->
		
		<!-- Set origin of image for scaling / rotating etc -->		
		<step type="setorigin">
			<id>bg</id> <!-- R - Image id for script -->
			<origin x=".5" y=".5"/> <!-- O - What the origin will be -->
		</step>
				
		<!-- Tween an image -->
		 
		<step type="tween">
			<id>bg</id> <!-- R - Image id for script -->
			<type>s</type> <!-- R - Type - tx ty (translate) r (rot) a (alpha) sx sy (scale) -->
			<rate>2</rate> <!-- R - Rate of tween -->
			<delay>1.5</delay>
			<destPoint x=".75" y=".75"/> <!-- O - Point to move to if necessary -->
			<ease>ease</ease>
		</step>
		
		<step type="tween">
			<id>bg</id> <!-- R - Image id for script -->
			<type>rty</type> <!-- R - Type - tx ty (translate) r (rot) a (alpha) sx sy (scale) -->
			<rate>3</rate> <!-- R - Rate of tween -->
			<delay>1.5</delay>
			<dest>-110</dest>
			<ease>ease</ease>
		</step>
			
		<step type="tween">
			<id>bg</id> <!-- R - Image id for script -->
			<type>rtx</type> <!-- R - Type - tx ty (translate) r (rot) a (alpha) sx sy (scale) -->
			<rate>3</rate> <!-- R - Rate of tween -->
			<delay>1.5</delay>
			<dest>200</dest>
			<ease>ease</ease>
		</step>	

			
        <step type="wait">
            <time>.5</time>
        </step>
        
        <step type="wait">
            <input>any</input>
            <delayprogress>5.4</delayprogress>
        </step>
        
        <step type="qpage">
            <id>p005</id>
            <wipe>ls</wipe>
            <rate>d</rate>
        </step>
        
        <step type="end"/>
        
	</script>
</page>